class Solution {
public:
    bool isPalindrome(int x) {

        long result = 0, temp;
        temp = x;

        while(temp>0)
        {
            result = result*10 + temp%10;
            temp /= 10;
        }

        if(result == x)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
};
