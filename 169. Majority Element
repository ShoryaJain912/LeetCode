class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n = nums.size();
        int count = 0;
        int answer = nums[0];

        for(int i = 0; i<n; i++) {
            if(count == 0) answer = nums[i];
            if(answer == nums[i]) count++;
            else count--;
        }

        return answer;
    }
};
