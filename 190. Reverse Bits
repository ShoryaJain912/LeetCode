class Solution {
public:
    int reverseBits(int n) {

    int arr[33];
    for(int i=0; i<33; i++)
    {
        arr[i]=n%2;
        n = n/2;
    }

    int result = 0;
    double power=1;

    for (int i = 31; i > 0; i--) {
    result = result + (arr[i] * power);
    power = power * 2;
}

return result;
    }
};
