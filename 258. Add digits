class Solution {
public:
    int addDigits(int num) {
        
        int temp = num;
        
        while(temp>=10)
        {
            int result = 0;
            while(temp>0)
            {
            result = result + temp%10;
            temp = temp/10;
            }
        
        temp = result;
        }
            return temp;
    }
};