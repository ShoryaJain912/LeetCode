class Solution {
public:
    int mySqrt(int x) {

        if (x < 2) return x;

        int low = 1, high = x/2;

        while(low<=high)
        {
            long middle = low + (high-low)/2;

            if(middle*middle<x)
            {
                low = middle + 1;
            }
            else if(middle*middle>x)
            {
                high = middle - 1;
            }
            else
            {
                return middle;
            }
        }
        
        int middle = (low + high)/2;
        return middle;
        
    }
};
